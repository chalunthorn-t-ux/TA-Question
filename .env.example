# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ------------------------------------------------------------------
# Gemini API key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# โมเดลที่ใช้ (ปรับได้)
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# ------------------------------------------------------------------
# พารามิเตอร์ RAG
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SCORE=0.15

# น้ำหนักผสมคะแนน (semantic vs keyword) ช่วยเรื่องภาษาไทย
HYBRID_ALPHA=0.7

# ------------------------------------------------------------------
# ระบบสมาชิก
# คีย์เซ็นคุกกี้ล็อกอิน — เว้นว่างไว้ได้ ระบบจะสร้างและเขียนกลับลง .env ให้เอง
# ⚠️ ห้ามเปลี่ยนหลังใช้งานแล้ว ไม่งั้นทุกคนหลุดออกจากระบบ
SESSION_SECRET=

# อายุการล็อกอิน (วินาที) ค่าเริ่มต้น 7 วัน
SESSION_MAX_AGE=604800

# ตั้งเป็น 1 เมื่อ deploy บน https (เช่น Vercel) เพื่อไม่ให้คุกกี้ส่งผ่าน http
SESSION_HTTPS_ONLY=

# ------------------------------------------------------------------
# ที่เก็บข้อมูลถาวร (จำเป็นเมื่อ deploy บน Vercel — ดิสก์ที่นั่นเขียนไม่ได้)
#
# PostgreSQL สำหรับบัญชีผู้ใช้ + log คำถามที่ตอบไม่ได้
# Vercel -> Storage -> Neon -> Connect จะฉีดค่านี้ให้เอง ใช้แบบ pooled (มี "-pooler")
# เว้นว่าง = เก็บลง storage/users.json เหมือนเดิม (พอสำหรับรันในเครื่อง)
DATABASE_URL=

# Vercel Blob สำหรับ index ความรู้ + เอกสารที่อัปผ่านหน้าเว็บ
# Vercel -> Storage -> Blob -> Connect จะฉีดค่านี้ให้เอง
# เว้นว่าง = อ่าน/เขียน storage/ ในดิสก์เหมือนเดิม
BLOB_READ_WRITE_TOKEN=

# โฟลเดอร์นำหน้าใน Blob — ⚠️ blob เป็น public ใครรู้ URL ก็อ่าน index ได้
# ใส่ค่าสุ่มยาว ๆ แล้วเก็บเป็นความลับ เช่น idx-9f3a1c7b8e
INDEX_BLOB_PREFIX=

# ------------------------------------------------------------------
APP_TITLE=TA Assistant
APP_SUBTITLE=ผู้ช่วยตอบคำถามสำหรับ TA (Training Assistant) ใหม่
# ------------------------------------------------------------------
# ประสิทธิภาพ / งบเวลา
# โมเดล gemini-3.x คิดก่อนตอบ ซึ่งกินเวลาส่วนใหญ่ จำกัดไว้ให้เร็วขึ้น (-1 = ไม่จำกัด)
GEMINI_THINKING_BUDGET=512

# งบเวลาต่อคำถาม (วินาที) ต้องน้อยกว่า maxDuration ใน vercel.json
# เลยงบแล้วระบบจะคืนข้อความจากเอกสารให้อ่าน ดีกว่าถูกตัดทิ้งเป็น 504
REQUEST_BUDGET_SECONDS=45
# ------------------------------------------------------------------
# ลบชื่อบุคคลก่อนเข้า index (เอกสารมีชื่อผู้เข้าอบรมจริง)
REDACT_NAMES=1
# ชื่อเจ้าหน้าที่ที่ต้องคงไว้ คั่นด้วยจุลภาค
REDACT_KEEP_NAMES=ทีน

# จำกัดจำนวนคำถามของผู้ที่ไม่ได้ล็อกอิน (0 = ไม่จำกัด)
ASK_RATE_LIMIT=30
ASK_RATE_WINDOW=3600
# แสดงการ์ดแหล่งอ้างอิงพร้อมข้อความจากเอกสารใต้คำตอบ (1 = แสดง)
# ปิดไว้เพราะหน้าเว็บเปิดให้คนทั่วไป ไม่ควรโชว์เนื้อหาดิบจากเอกสารภายใน
SHOW_SOURCES=0
