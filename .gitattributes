# ให้ Git จัดการ line ending อัตโนมัติ — กัน diff รบกวนเวลาทำงานข้าม Windows/macOS/Linux
* text=auto eol=lf

# สคริปต์ Windows ต้องเป็น CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ไฟล์ไบนารี — ห้ามแปลง
*.pdf  binary
*.docx binary
*.xlsx binary
*.xls  binary
*.npy  binary
*.png  binary
*.jpg  binary
